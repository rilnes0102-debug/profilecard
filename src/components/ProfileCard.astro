---
import { string } from "astro:schema";


interface Props {
    nama: string;
    kelas: string;
    bio: string;
    foto: string;
    keahlian: string[];
    github: string;
    email: string;
}

const { nama, kelas, bio, foto, keahlian, github, email } = Astro.props;

const inisial = nama
.split(" ")
.map((kata) => kata[0])
.join("")
.slice(0, 2)
.toUpperCase();

---


<div class="card">
    {foto ?(
        <img class="foto" src={foto} alt={'Foto ${nama}'} />
    ) : (
        <div class="foto inisial">{inisial}</div>
    )}

<h1>{nama}</h1>
<p class="kelas">{kelas}</p>
<p class="bio">{bio}</p>

<ul class="keahlian">
    {keahlian.map((item) => <li>{item}</li>)}
</ul>

<div class="tautan">
    <a href={github} target="_blank">Github</a>
    <a href={`mailto:${email}`} target="_blank">Email</a>
</div>

</div>

<style>
    .card{
        width: 100%;
        max-width: 360px;
        background: #ffffff;
        border-radius: 20px;
        padding: 32px 24px;
        text-align: center;
        box-shadow: 0 20px 40px rgba (0, 0, 0, 0.25);
        
    }

.foto{
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(98, 238, 17, 0.667);
    margin: 0 auto 16px;
}

.inisial {
    display: flex;
    align-items: center;
    justify-content: center;
    background: 1e3a8a;
    color: #ffffff;
    font-size: 40px;
    font-weight: bold;
}

h1 {
    margin: 0;
    font-size: 40px;
}

.kelas {
    margin: 4px 16px;
    color: #0f766e;
    font-weight: bold;
}

.bio{
    color: #4b5563;
    line-height: 1.5;
}

.keahlian {
    list-style: none;
    padding: 0;
    margin: 16px 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
}

.keahlian li {
    background: #e0f2fe;
    color: #1e3a8a;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 14px;
}

.tautan {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 8px;
}

.tautan a {
    flex: 1;
    padding: 10px;
    border-radius: 10px;
    background: #1e3a8a;
    color: #ffffff;
    text-decoration: none;
    font-weight: bold;
}

.tautan a:hover {
    background: #0f766e;
}



</style>